DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/gleyforgym

SECRET_KEY=change-me-to-a-long-random-string

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

CORS_ORIGINS=http://localhost:5173

# Opcionales: solo requeridas para enviar correos reales (recuperación de
# contraseña, verificación de correo, ver app/correo.py y Pendientes.md
# P-01/P-03). Sin ellas, el correo solo queda logueado (modo desarrollo).
# Se usa la API HTTPS de Brevo (brevo.com) en vez de SMTP directo porque
# Render no deja completar conexiones SMTP salientes. BREVO_SENDER_EMAIL
# debe estar verificado en el panel de Brevo (Senders) antes de usarse.
BREVO_API_KEY=xkeysib-tu-api-key
BREVO_SENDER_EMAIL=tu-correo-verificado@gmail.com
BREVO_SENDER_NAME=GleyforGym

# URL pública del frontend, usada para armar los enlaces de los correos.
FRONTEND_URL=http://localhost:5173

# Opcional: solo requerida para la integración híbrida con Claude en el
# motor de IA (ver app/ia/claude_client.py). Sin ella, el sistema usa
# directamente el motor de reglas.
ANTHROPIC_API_KEY=sk-ant-tu-llave
CLAUDE_MODEL_IA=claude-haiku-5-5

# Opcionales: solo requeridas para declarar Boletas electrónicas ante SUNAT
# (ver app/facturacion_electronica/ y Pendientes.md P-24). Sin SUNAT_RUC, el
# sistema no intenta declarar nada -- la venta/pago se confirma igual.
# Para probar contra el ambiente de pruebas de SUNAT (no el RUC real del
# gimnasio): SUNAT_RUC=20000000001, SUNAT_USUARIO_SOL=MODDATOS,
# SUNAT_CLAVE_SOL=MODDATOS, SUNAT_AMBIENTE=beta, y un certificado
# autofirmado (basta para beta, no hace falta el Certificado Digital
# Tributario real todavía).
SUNAT_RUC=
SUNAT_USUARIO_SOL=
SUNAT_CLAVE_SOL=
SUNAT_AMBIENTE=beta
SUNAT_WSDL_PRODUCCION=
SUNAT_CERTIFICADO_PEM=
SUNAT_LLAVE_PRIVADA_PEM=
SUNAT_SERIE_BOLETA=B001
