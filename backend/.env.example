DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/gleyforgym

SECRET_KEY=change-me-to-a-long-random-string

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

CORS_ORIGINS=http://localhost:5173

# Opcionales: solo requeridas si se activa CulqiGateway (ver
# app/pagos_gateway/culqi.py y Pendientes.md P-02). Mientras tanto el sistema
# usa MockGateway y no las necesita.
CULQI_SECRET_KEY=sk_test_tu_llave_secreta
CULQI_PUBLIC_KEY=pk_test_tu_llave_publica

# Opcionales: solo requeridas para enviar correos reales (recuperación de
# contraseña, verificación de correo, ver app/correo.py y Pendientes.md
# P-01/P-03). Sin ellas, el correo solo queda logueado (modo desarrollo).
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=contraseña-de-aplicacion-de-16-caracteres

# URL pública del frontend, usada para armar los enlaces de los correos.
FRONTEND_URL=http://localhost:5173

# Opcional: solo requerida para la integración híbrida con Claude en el
# motor de IA (ver app/ia/claude_client.py). Sin ella, el sistema usa
# directamente el motor de reglas.
ANTHROPIC_API_KEY=sk-ant-tu-llave
CLAUDE_MODEL_IA=claude-haiku-5-5
